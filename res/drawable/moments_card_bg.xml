<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/moments_card_active" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/moments_card" />
                    <stroke android:width="1dp" android:color="@color/moments_card_stroke" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
