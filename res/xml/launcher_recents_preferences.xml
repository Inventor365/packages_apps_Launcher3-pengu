<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <PreferenceCategory
        android:key="task_changer_layout_category"
        android:title="@string/task_changer_layout_title">

        <com.android.launcher3.settings.preferences.TaskChangerLayoutPreference
            android:key="pref_recents_layout"
            android:defaultValue="carousel" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="task_changer_details_category"
        android:title="@string/task_changer_details_title">

        <SwitchPreferenceCompat
            android:key="pref_recents_mini"
            android:title="@string/task_changer_mini_title"
            android:summary="@string/task_changer_mini_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_center_running"
            android:title="@string/task_changer_center_title"
            android:summary="@string/task_changer_center_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_recents_app_label"
            android:title="@string/task_changer_label_title"
            android:summary="@string/task_changer_label_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_recents_circular"
            android:title="@string/task_changer_circular_title"
            android:summary="@string/task_changer_circular_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_search"
            android:title="@string/task_changer_search_title"
            android:summary="@string/task_changer_search_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/general_category_title">

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_recents_opacity"
            android:title="@string/background_opacity_title"
            android:persistent="true"
            android:max="100"
            android:min="0"
            settings:units="%"
            android:defaultValue="40" />

        <SwitchPreferenceCompat
            android:key="pref_recents_meminfo"
            android:title="@string/recents_meminfo_title"
            android:defaultValue="false"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/actions_category_title">

        <SwitchPreferenceCompat
            android:key="pref_recents_chips"
            android:title="@string/recents_chips_title"
            android:summary="@string/recents_chips_summary"
            android:defaultValue="false"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_screenshot"
            android:title="@string/recents_screenshot_title"
            android:defaultValue="true"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_lens"
            android:title="@string/recents_lens_title"
            android:defaultValue="false"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="pref_recents_clear_all"
            android:title="@string/recents_clear_all_title"
            android:defaultValue="true"
            android:persistent="true"
            launcher:iconSpaceReserved="false" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
