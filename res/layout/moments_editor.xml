<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/moments_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/moment_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/moment_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/moments_icon_button_bg"
                android:contentDescription="@string/moments_change_icon"
                android:padding="18dp"
                android:tint="@color/moments_text" />

            <TextView
                android:id="@+id/moment_name"
                style="@style/MomentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/moments_rename"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/moment_switch_to"
                style="@style/MomentsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="24dp"
                android:text="@string/moments_switch_to" />

            <TextView
                android:id="@+id/moment_active"
                style="@style/MomentsBodySmall"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/moments_active" />

            <Space
                android:layout_width="0dp"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
