<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/outdoor_dock_pill_height"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/outdoor_dock_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:id="@+id/outdoor_dock_apps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <View
            android:id="@+id/outdoor_dock_divider"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/outdoor_dock_divider" />

        <ImageView
            android:id="@+id/outdoor_dock_menu"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/outdoor_dock_menu_bg"
            android:contentDescription="@string/outdoor_menu"
            android:padding="12dp"
            android:src="@drawable/ic_outdoor_menu" />
    </LinearLayout>
</FrameLayout>
