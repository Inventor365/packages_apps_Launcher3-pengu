<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.moments.MomentsSwitchOverlay xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moments_switch_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:visibility="gone">

    <View
        android:id="@+id/moments_switch_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/moments_switch_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="92dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="158dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/moments_switch_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/moments_switch_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginBottom="4dp"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/moments_switch_text"
                style="@style/MomentsSwitchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:id="@+id/moments_switch_bar"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="@drawable/moments_switch_bar" />
    </LinearLayout>
</com.android.launcher3.moments.MomentsSwitchOverlay>
