<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <include layout="@layout/moments_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <TextView
            style="@style/MomentsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/moments_name_title" />

        <ImageView
            android:id="@+id/moment_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/moments_icon_button_bg"
            android:contentDescription="@string/moments_change_icon"
            android:padding="18dp"
            android:tint="@color/moments_text" />

        <include
            android:id="@+id/moment_name_editor"
            layout="@layout/moments_name_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/moments_continue"
        style="@style/MomentsButton"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="20dp"
        android:text="@string/moments_add" />
</LinearLayout>
