<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/MomentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="40dp"
                android:paddingHorizontal="32dp"
                android:text="@string/moments_picker_title" />

            <LinearLayout
                android:id="@+id/moments_stats"
                style="@style/MomentsGroup"
                android:layout_marginBottom="20dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/moments_stats_time"
                    style="@style/MomentsBodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/moments_stats_unlocks"
                    style="@style/MomentsBodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moments_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/moments_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/moments_circle_bg"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_moment_add"
                    android:tint="@color/moments_text" />

                <TextView
                    style="@style/MomentsBodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/moments_add"
                    android:textColor="@color/moments_text"
                    android:textFontWeight="500"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/moments_max"
                style="@style/MomentsBodySmall"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/moments_max_reached"
                android:textColor="@color/moments_text"
                android:textSize="10sp"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <com.android.launcher3.moments.HoldToExitButton
            android:id="@+id/moments_exit"
            style="@style/MomentsButton"
            android:text="@string/moments_hold_to_exit"
            android:visibility="gone" />

        <TextView
            android:id="@+id/moments_add_tile"
            style="@style/MomentsBodySmall"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/moments_add_tile" />
    </LinearLayout>
</LinearLayout>
