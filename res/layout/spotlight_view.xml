<com.android.launcher3.search.universal.SpotlightView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    launcher:layout_ignoreInsets="true">

    <FrameLayout
        android:id="@+id/spotlight_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/spotlight_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <FrameLayout
            android:id="@+id/spotlight_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_spotlight_card"
            android:elevation="12dp">
            <ImageView
                android:id="@+id/spotlight_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="@android:color/transparent"
                android:importantForAccessibility="no"
                android:scaleType="matrix" />
            <LinearLayout
                android:id="@+id/spotlight_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">
                <LinearLayout
                    android:id="@+id/spotlight_field"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_allapps_search"
                        android:tint="#DDFFFFFF" />
                    <EditText
                        android:id="@+id/spotlight_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/spotlight_hint"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text|textNoSuggestions"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textColorHighlight="#667EB7FF"
                        android:textColorHint="#BBFFFFFF"
                        android:textSize="22sp" />
                    <ImageView
                        android:id="@+id/spotlight_clear"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="14dp"
                        android:contentDescription="@string/spotlight_clear_query"
                        android:src="@drawable/ic_spotlight_clear"
                        android:tint="#EEFFFFFF" />
                    <ImageView
                        android:id="@+id/spotlight_mic"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:contentDescription="@string/spotlight_voice"
                        android:src="@drawable/ic_mic_themed"
                        android:tint="#DDFFFFFF" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#33FFFFFF" />
                <FrameLayout
                    android:id="@+id/spotlight_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/spotlight_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingBottom="16dp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</com.android.launcher3.search.universal.SpotlightView>
